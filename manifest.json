{
  "name": "Hello Extensions of the world!",
  "description": "Base Level Extension",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  },
  "minimum_window_size": {
    "width": 400,
    "height": 500
  }
}